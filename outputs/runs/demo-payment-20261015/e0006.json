    {
      "query_id": "q-f97872cc476b6362",
      "template": "daily_metrics_platform",
      "sql": "WITH \nuser_day AS (\n SELECT t.date,t.user_id,u.device_id,COUNT(*) n,SUM(t.amount_idr) gmv\n FROM transactions t JOIN users u ON u.user_id=t.user_id\n WHERE t.date BETWEEN :start AND :end GROUP BY t.date,t.user_id,u.device_id\n), device_day AS (\n SELECT date,device_id,COUNT(*) payers FROM user_day GROUP BY date,device_id\n), risk AS (\n SELECT p.date,p.user_id FROM user_day p JOIN device_day d\n ON p.date=d.date AND p.device_id=d.device_id\n WHERE p.n>=5 AND p.gmv>=2000000 AND d.payers>=3\n)\n,\n    views AS (\n      SELECT v.date,u.platform dimension,COUNT(DISTINCT v.user_id) active_uv\n      FROM view_sessions v JOIN users u ON u.user_id=v.user_id JOIN streamers s ON s.streamer_id=v.streamer_id\n      WHERE v.date BETWEEN :start AND :end  GROUP BY v.date,dimension\n    ), attempts AS (\n      SELECT a.date,u.platform dimension,COUNT(*) attempts,SUM(a.status='success') successes\n      FROM payment_attempts a JOIN users u ON u.user_id=a.user_id JOIN streamers s ON s.streamer_id=a.streamer_id\n      WHERE a.date BETWEEN :start AND :end  GROUP BY a.date,dimension\n    ), revenue AS (\n      SELECT t.date,u.platform dimension,COUNT(DISTINCT t.user_id) paying_uv,SUM(t.amount_idr) gross_gmv_idr,\n      SUM(CASE WHEN r.user_id IS NOT NULL THEN t.amount_idr ELSE 0 END) suspicious_gmv_idr\n      FROM transactions t JOIN users u ON u.user_id=t.user_id JOIN streamers s ON s.streamer_id=t.streamer_id\n      LEFT JOIN risk r ON r.date=t.date AND r.user_id=t.user_id\n      WHERE t.date BETWEEN :start AND :end  GROUP BY t.date,dimension\n    ), keys AS (\n      SELECT date,dimension FROM views UNION SELECT date,dimension FROM attempts UNION SELECT date,dimension FROM revenue\n    ) SELECT k.date,k.dimension,COALESCE(v.active_uv,0) active_uv,COALESCE(a.attempts,0) attempts,\n      COALESCE(a.successes,0) successes,COALESCE(t.paying_uv,0) paying_uv,\n      COALESCE(t.gross_gmv_idr,0) gross_gmv_idr,COALESCE(t.suspicious_gmv_idr,0) suspicious_gmv_idr\n      FROM keys k LEFT JOIN views v ON k.date=v.date AND k.dimension=v.dimension\n      LEFT JOIN attempts a ON k.date=a.date AND k.dimension=a.dimension\n      LEFT JOIN revenue t ON k.date=t.date AND k.dimension=t.dimension ORDER BY k.date,k.dimension",
      "parameters": {
